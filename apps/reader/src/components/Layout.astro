---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import '../styles/reader.css';
interface Props { title: string; }
const { title } = Astro.props;
const privateMode = process.env.READER_MODE !== 'public';
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · Research library</title><meta name="robots" content="noindex,nofollow" /></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="masthead"><a href="/">Research library</a><span>{privateMode ? 'Private collection' : 'Approved research notes'}</span>{privateMode && <a href="/.auth/logout?post_logout_redirect_uri=/login.html">Sign out</a>}</header><slot /></body></html>
