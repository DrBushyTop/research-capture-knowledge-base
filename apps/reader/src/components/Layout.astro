---
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-serif-4';
import '../styles/reader.css';
import '../styles/sources.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title: string; }
const { title } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · Research library</title><meta name="robots" content="noindex,nofollow" /><ClientRouter fallback="swap" /></head>
<body transition:animate="none"><a class="skip-link" href="#main">Skip to content</a><header class="masthead"><a href="/">Research library</a><nav aria-label="Library"><a href="/" aria-current={path === '/' || path.startsWith('/chat') ? 'page' : undefined}>Chat</a><a href="/sources/" aria-current={path.startsWith('/sources') || path.startsWith('/research') ? 'page' : undefined}>Sources</a><a href="/categories/" aria-current={path.startsWith('/categories') ? 'page' : undefined}>Categories</a></nav><a class="sign-out" data-astro-reload href="/.auth/logout?post_logout_redirect_uri=/login.html">Sign out</a></header><slot />
<script>
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';
  const pages = new Map<string, { document: Document; expires: number }>();
  const cacheable = (url: URL) => url.origin === location.origin && ['/', '/chat/', '/sources/', '/categories/'].includes(url.pathname);
  document.addEventListener('astro:before-preparation', event => {
    const navigation = event as TransitionBeforePreparationEvent;
    if (!navigation.to || navigation.formData || !cacheable(navigation.to)) return;
    const cached = pages.get(navigation.to.pathname);
    if (cached && cached.expires > Date.now()) {
      navigation.loader = async () => { navigation.newDocument = cached.document.cloneNode(true) as Document; };
    } else {
      const load = navigation.loader;
      navigation.loader = async () => {
        await load();
        if (!navigation.defaultPrevented && !navigation.signal.aborted
          && navigation.newDocument.querySelector('[name="astro-view-transitions-enabled"]')
          && navigation.newDocument.querySelector('#main')) {
          // These documents are static empty shells, never private corpus data.
          pages.set(navigation.to.pathname, { document: navigation.newDocument.cloneNode(true) as Document, expires: Date.now() + 60_000 });
        }
      };
    }
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('.sign-out')) pages.clear();
  });
  // Keep client routing, without interpolating screenshots of differently sized pages.
  // Setting body transition:animate alone leaves the browser's root animation enabled.
  document.addEventListener('astro:before-swap', (event) => {
    (event as Event & { viewTransition?: { skipTransition(): void } }).viewTransition?.skipTransition();
  });
</script>
</body></html>
