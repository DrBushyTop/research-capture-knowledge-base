---
import { getCollection } from 'astro:content';
import { categoryTone, sourceTypeLabel } from '../lib/labels';
interface Props { current?: string; }
const { current } = Astro.props;
const entries = await getCollection('research');
const year = (date: string | null) => date?.match(/\b(?:19|20)\d{2}\b/)?.[0] || 'Unknown';
const topics = [...new Set(entries.flatMap(e => e.data.note.analysis?.topics || e.data.note.source.tags))].sort();
const categoryOf = (note: (typeof entries)[number]['data']['note']) => note.schemaVersion === 2 ? note.category : null;
const categories = [...new Map(entries.flatMap(e => { const c = categoryOf(e.data.note); return c ? [[c.id, c.name] as const] : []; })).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const types = [...new Set(entries.map(e => e.data.note.source.itemType))].sort();
const years = [...new Set(entries.map(e => year(e.data.note.source.publishedAt)))].sort().reverse();
---
<aside class="source-list" aria-label="Saved sources">
  <div class="source-list-head">
    {current ? <h2 class="source-list-title">Sources</h2> : <h1 class="source-list-title">Sources</h1>}
    <div class="source-search"><label class="visually-hidden" for="search">Search sources</label><input id="search" type="search" placeholder="Search titles, findings, notes" autocomplete="off" /><button type="button" id="filter-toggle" class="filter-toggle" aria-expanded="false" aria-controls="filters">Filters<span id="filter-count" hidden></span></button></div>
    <div class="filters" id="filters">
      {categories.length > 0 && <div><label for="category">Category</label><select id="category"><option value="">All</option>{categories.map(([id, name]) => <option value={id}>{name}</option>)}</select></div>}
      <div><label for="topic">Topic</label><select id="topic"><option value="">All</option>{topics.map(t => <option>{t}</option>)}</select></div>
      <div><label for="type">Type</label><select id="type"><option value="">All</option>{types.map(t => <option value={t}>{sourceTypeLabel(t)}</option>)}</select></div>
      <div><label for="year">Year</label><select id="year"><option value="">All</option>{years.map(y => <option>{y}</option>)}</select></div>
    </div>
    <p id="search-status" role="status" aria-live="polite">{entries.length} {entries.length === 1 ? 'source' : 'sources'}</p>
  </div>
  <ul class="source-rows" id="results">{entries.map(({ data: { note } }) => { const category = categoryOf(note); return <li data-id={note.source.id} data-topics={JSON.stringify(note.analysis?.topics || note.source.tags)} data-type={note.source.itemType} data-year={year(note.source.publishedAt)} data-category={category?.id || ''}>
    <a href={`/research/${note.source.id}/`} aria-current={note.source.id === current ? 'page' : undefined} data-tone={categoryTone(category?.id)}>
      <span class="source-meta">{category && <span class="category-chip">{category.name}</span>}<span>{sourceTypeLabel(note.source.itemType)} · {year(note.source.publishedAt)}</span></span>
      <span class="source-title">{note.source.title}</span>
      <span class="source-summary">{note.analysis?.summary || note.extraction.reason || 'Metadata saved; analysis unavailable.'}</span>
      {note.extraction.status !== 'text' && <span class="status attention">Needs review</span>}
    </a></li>; })}</ul>
  <p id="empty" class="source-empty" hidden={entries.length > 0}>{entries.length ? 'No sources match. Change the search or clear a filter.' : 'No sources yet.'}</p>
  <noscript><p class="source-empty">Search and filters need JavaScript.</p></noscript>
</aside>
<script is:inline type="module" src="/reader-search.js"></script>
