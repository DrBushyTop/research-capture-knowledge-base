---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
export function getStaticPaths() { return process.env.READER_MODE === 'public' ? [] : [{ params: { path: undefined } }]; }
const entries = await getCollection('research');
const visual = entries.filter(({ data: { note } }) => note.extraction.artifactHash && (note.extraction.method === 'pdf-text' || note.extraction.artifactMime?.startsWith('image/')));
---
<Layout title="Ask your collection"><div class="chat-layout"><aside class="chat-margin"><a class="back-link" href="/">Back to saved sources</a><h1>Ask your collection</h1><p>Follow a question through the sources you saved.</p><div class="chat-context"><label for="chat-source">Use evidence from</label><select id="chat-source"><option value="">Your collection</option>{entries.map(({ data: { note } }) => <option value={note.source.id}>{note.source.title}</option>)}</select><details><summary>Look at a page or image</summary><label for="chat-visual">Stored PDF or image</label><select id="chat-visual"><option value="">Text only</option>{visual.map(({ data: { note } }) => <option value={note.source.id}>{note.source.title}</option>)}</select><label for="chat-page">Page number</label><input id="chat-page" form="chat-form" type="number" min="1" max="200" step="1" value="1" required disabled /><p>Enter a whole page number from 1 to 200 for a PDF. Images use page 1.</p></details></div><p class="margin-help">Answers distinguish source text, generated analysis, and human notes. Check the cited evidence before relying on an interpretation.</p></aside><main id="main" class="chat-surface"><div class="chat-reading"><div id="chat-empty"><h2>What would you like to understand?</h2><p>Ask about a finding, compare saved sources, or inspect a figure. Chat can only use what is stored in this collection.</p></div><div id="chat-transcript" aria-label="Conversation"></div><form id="chat-form"><label for="chat-question">Your question</label><textarea id="chat-question" rows="4" maxlength="2000" required placeholder="What do these sources say about…" aria-describedby="chat-help"></textarea><div class="chat-actions"><button id="chat-submit" type="submit" disabled={entries.length === 0}>Ask collection</button><button id="chat-clear" type="button" class="text-button" hidden>New conversation</button></div><p id="chat-help">Private chat · GPT-6.1 Sol. Conversation clears when you leave this page. Questions and answers expire after 24 hours.</p><p id="chat-status" role="status" aria-live="polite">{entries.length ? '' : 'Add a source to your collection before asking a question.'}</p><a id="chat-signin" href="/.auth/login/github?post_login_redirect_uri=/chat/" hidden>Sign in again</a></form><noscript><p>Chat needs JavaScript. You can still read your saved sources.</p></noscript></div></main></div></Layout>
<script is:inline type="module" src="/reader-chat.js"></script>
