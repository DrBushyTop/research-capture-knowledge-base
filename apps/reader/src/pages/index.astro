---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
const entries = await getCollection('research');
const year = (date: string | null) => date?.match(/\b(?:19|20)\d{2}\b/)?.[0] || 'Unknown';
const topics = [...new Set(entries.flatMap(e => e.data.note.analysis?.topics || e.data.note.source.tags))].sort();
const types = [...new Set(entries.map(e => e.data.note.source.itemType))].sort();
const years = [...new Set(entries.map(e => year(e.data.note.source.publishedAt)))].sort().reverse();
---
<Layout title="Saved sources"><div class="library-layout"><aside class="library-margin"><h1>Saved sources</h1><p>Find a source. Pick up a thought.</p><div class="filters"><div class="search-field"><label for="search">Search your research</label><input id="search" type="search" placeholder="A topic, finding, or title" /></div><div class="select-field"><label for="topic">Topic</label><select id="topic"><option value="">All topics</option>{topics.map(t => <option>{t}</option>)}</select></div><div class="select-field"><label for="type">Source type</label><select id="type"><option value="">All types</option>{types.map(t => <option>{t}</option>)}</select></div><div class="select-field"><label for="year">Publication year</label><select id="year"><option value="">All years</option>{years.map(y => <option>{y}</option>)}</select></div></div><p id="search-status" role="status" aria-live="polite">{entries.length} saved sources</p></aside>
<main id="main" class="library-results"><h2>Your collection</h2><ul class="source-register" id="results">{entries.map(({ data: { note } }) => <li data-id={note.source.id} data-topics={JSON.stringify(note.analysis?.topics || note.source.tags)} data-type={note.source.itemType} data-year={year(note.source.publishedAt)}><a href={`/research/${note.source.id}/`}><span class="source-kind">{note.source.itemType} · {year(note.source.publishedAt)}</span><h3>{note.source.title}</h3><p>{note.analysis?.summary || note.extraction.reason || 'Metadata saved; analysis unavailable.'}</p><span class:list={['status', { attention: note.extraction.status !== 'text' }]}>{note.extraction.status === 'text' ? 'Machine analysis · not reviewed' : 'Needs review · limited evidence'}</span></a></li>)}</ul><p id="empty" hidden={entries.length > 0}>{entries.length ? 'No sources match. Try another search or clear a filter.' : 'Your collection is waiting for its first processed capture.'}</p><noscript><p>All sources are listed above. Search and filters need JavaScript.</p></noscript></main></div></Layout>
<script is:inline type="module" src="/reader-search.js"></script>
