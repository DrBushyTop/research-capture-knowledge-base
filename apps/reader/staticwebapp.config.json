{
  "routes": [
    {
      "route": "/.auth/login/aad",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/login.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/access.js",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/access.css",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/manifest.webmanifest",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/pwa.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/sw.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/offline.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/icons/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/logout.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/logout.js",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/index.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/session-start",
      "methods": ["POST"],
      "allowedRoles": ["library_member"]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/assets/*",
      "allowedRoles": [
        "anonymous"
      ],
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.{html,js,css,json,map,woff,woff2,ttf,otf,png,jpg,jpeg,gif,svg,webp,ico,pdf,txt,xml}",
      "allowedRoles": [
        "library_member"
      ]
    },
    {
      "route": "/*",
      "rewrite": "/index.html",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "rewrite": "/login.html",
      "statusCode": 401
    },
    "403": {
      "rewrite": "/login.html",
      "statusCode": 403
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY",
    "Cache-Control": "private, no-store"
  },
  "platform": {
    "apiRuntime": "node:22"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
