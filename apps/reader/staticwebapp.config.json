{
  "routes": [
    {
      "route": "/.auth/login/aad",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/login.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/access.js",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/access.css",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "library_member"
      ]
    },
    {
      "route": "/assets/*",
      "allowedRoles": [
        "library_member"
      ]
    },
    {
      "route": "/*.{html,js,css,json,map,woff,woff2,ttf,otf,png,jpg,jpeg,gif,svg,webp,ico,pdf,txt,xml}",
      "allowedRoles": [
        "library_member"
      ]
    },
    {
      "route": "/*",
      "rewrite": "/index.html",
      "allowedRoles": [
        "library_member"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/login.html",
      "statusCode": 403
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY",
    "Cache-Control": "private, no-store"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
