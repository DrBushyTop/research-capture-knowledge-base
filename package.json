{
  "name": "research-capture-knowledge-base",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:reader && npm test && npm run build:reader",
    "build:worker": "node scripts/build-worker.mjs",
    "build:reader": "vite build --config apps/reader/vite.config.ts && node scripts/verify-reader-build.mjs",
    "dev": "tsx scripts/dev.ts",
    "db:migrate": "tsx scripts/sql-migrate.ts",
    "db:import": "tsx scripts/sql-import.ts",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "test:sql": "TEST_SQL=1 vitest run tests/sql-store.test.ts",
    "import": "tsx scripts/import-corpus.ts",
    "operate": "tsx scripts/operate.ts",
    "check:reader": "tsc --noEmit -p apps/reader",
    "preview": "vite preview --config apps/reader/vite.config.ts --host 0.0.0.0",
    "dev:worker": "tsx scripts/dev-worker.ts"
  },
  "dependencies": {
    "@azure/containerapps-sandbox": "^1.0.0-beta.1",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.34.0",
    "@azure/storage-queue": "^12.32.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@llamaindex/liteparse": "2.15.1",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "ai": "^7.0.128",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "gray-matter": "^4.0.3",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "minisearch": "^7.2.0",
    "mssql": "^12.7.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "use-stick-to-bottom": "^1.1.6",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
