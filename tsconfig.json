{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["shared/**/*.ts", "apps/worker/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
